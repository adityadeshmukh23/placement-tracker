# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Dashboard → Project Settings → API). Both are safe to expose to the
# browser — the anon key only grants what Row Level Security allows, and RLS
# requires a signed-in user. See docs/CLOUD_SYNC_SETUP.md.
#
# Leave these unset and the app runs fully offline with no sync (the default).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The email of the single shared household account that everyone's
# PIN signs into. Nobody types this — the PIN is that account's password. Only
# change it if you created the shared Supabase user under a different email.
NEXT_PUBLIC_SYNC_EMAIL=household@rental-book.app
